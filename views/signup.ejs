<%- include('partials-head') %><main class="auth-shell"><section class="auth-card"><a class="brand auth-brand" href="/"><span class="brand-mark">S</span> StockFlow</a><p class="eyebrow">GET STARTED</p><h1>Create your workspace</h1><p class="muted">Set up your organization and start tracking stock.</p><% if(error){ %><div class="notice error"><%= error %></div><% } %><form method="post" action="/signup" class="stack"><label>Organization name<input name="organizationName" required maxlength="100" placeholder="My Test Store"></label><label>Email address<input type="email" name="email" required autocomplete="email" placeholder="you@company.com"></label><label>Password<input type="password" name="password" required minlength="8" autocomplete="new-password" placeholder="At least 8 characters"></label><label>Confirm password<input type="password" name="confirmPassword" required minlength="8" autocomplete="new-password" placeholder="Enter password again"></label><button class="btn primary full">Create account</button></form><p class="auth-foot">Already have an account? <a href="/login">Sign in</a></p></section><aside class="auth-aside"><div><span class="eyebrow">ONE SIMPLE INVENTORY VIEW</span><h2>Spend less time counting. More time growing.</h2><p>A focused inventory dashboard for small teams and independent sellers.</p></div><div class="aside-bottom">StockFlow · Inventory workspace</div></aside></main></body></html>
