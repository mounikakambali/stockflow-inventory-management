<%- include('partials-head') %><%- include('partials-nav') %><main class="container"><%- include('partials-flash') %><div class="page-heading"><div><p class="eyebrow">OVERVIEW</p><h1>Good to see you</h1><p class="muted">Here’s what’s happening with your inventory.</p></div><a class="btn primary" href="/products/new">＋ Add product</a></div><section class="stats-grid"><article class="stat-card"><span class="stat-icon purple">▦</span><p>Total products</p><strong><%= stats.product_count %></strong><small>Products in your catalog</small></article><article class="stat-card"><span class="stat-icon blue">▤</span><p>Units in stock</p><strong><%= stats.units.toLocaleString('en-IN') %></strong><small>Total quantity on hand</small></article><article class="stat-card"><span class="stat-icon orange">!</span><p>Low-stock items</p><strong><%= lowStock.length %></strong><small>At or below their threshold</small></article></section><section class="panel"><div class="panel-heading"><div><h2>Low-stock items</h2><p class="muted">Products that may need replenishment</p></div><a class="text-link" href="/products">View all products →</a></div><% if(lowStock.length){ %><div class="table-wrap"><table><thead><tr><th>Product</th><th>SKU</th><th>Quantity</th><th>Threshold</th><th>Status</th></tr></thead><tbody><% lowStock.forEach(p=>{ %><tr><td class="primary-cell"><%= p.name %></td><td><%= p.sku %></td><td><strong><%= p.quantity %></strong></td><td><%= p.threshold %></td><td><span class="pill warning">Low stock</span></td></tr><% }) %></tbody></table></div><% } else { %><div class="empty-state"><span class="empty-icon">✓</span><h3>All stocked up</h3><p>No products are currently at or below their low-stock threshold.</p></div><% } %></section></main></body></html>
