<%- include('partials-head') %><%- include('partials-nav') %><main class="container"><%- include('partials-flash') %><div class="page-heading"><div><p class="eyebrow">CATALOG</p><h1>Products</h1><p class="muted">Manage your products and on-hand quantities.</p></div><a class="btn primary" href="/products/new">＋ Add product</a></div><section class="panel"><form class="search-row" method="get" action="/products"><div class="search-box"><span>⌕</span><input name="q" value="<%= q %>" placeholder="Search by product name or SKU"></div><button class="btn secondary">Search</button><% if(q){ %><a class="text-link" href="/products">Clear</a><% } %></form><% if(products.length){ %><div class="table-wrap"><table><thead><tr><th>Product</th><th>SKU</th><th>Quantity</th><th>Stock status</th><th>Selling price</th><th></th></tr></thead><tbody><% products.forEach(p=>{ const limit=p.low_stock_threshold===null?threshold:p.low_stock_threshold; const low=p.quantity<=limit; %><tr><td><div class="primary-cell"><%= p.name %></div><% if(p.description){ %><small class="muted"><%= p.description %></small><% } %></td><td><%= p.sku %></td><td><strong><%= p.quantity %></strong></td><td><span class="pill <%= low?'warning':'success' %>"><%= low?'Low stock':'In stock' %></span></td><td><%= p.selling_price===null?'—':'₹'+Number(p.selling_price).toFixed(2) %></td><td class="actions"><a class="text-link" href="/products/<%= p.id %>/edit">Edit</a><form method="post" action="/products/<%= p.id %>/delete" onsubmit="return confirm('Delete this product? This cannot be undone.')"><button class="link-button danger-text">Delete</button></form></td></tr><% }) %></tbody></table></div><% } else { %><div class="empty-state"><span class="empty-icon">▦</span><h3><%= q?'No matching products':'Your catalog is empty' %></h3><p><%= q?'Try another name or SKU.':'Add your first product to start tracking inventory.' %></p><% if(!q){ %><a class="btn primary" href="/products/new">Add your first product</a><% } %></div><% } %></section></main></body></html>
