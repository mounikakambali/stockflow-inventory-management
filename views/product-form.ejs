<%- include('partials-head') %><%- include('partials-nav') %><main class="container narrow"><div class="breadcrumbs"><a href="/products">Products</a> / <%= product.id?'Edit product':'New product' %></div><div class="page-heading"><div><p class="eyebrow">PRODUCT CATALOG</p><h1><%= product.id?'Edit product':'Add a product' %></h1><p class="muted">Enter the details you use to identify and track this item.</p></div></div><section class="panel form-panel"><% if(error){ %><div class="notice error"><%= error %></div><% } %><form method="post" action="<%= product.id?'/products/'+product.id:'/products' %>" class="stack"><div class="form-grid"><label class="span-2">Product name *<input name="name" required maxlength="120" value="<%= product.name||'' %>" placeholder="e.g. Classic Cotton T-Shirt"></label><label>SKU *<input name="sku" required maxlength="60" value="<%= product.sku||'' %>" placeholder="e.g. TSHIRT-001"></label><label>Quantity on hand *<input type="number" name="quantity" min="0" step="1" required value="<%= product.quantity??0 %>"></label><label>Cost price (₹)<input type="number" name="costPrice" min="0" step="0.01" value="<%= product.cost_price??product.costPrice??'' %>" placeholder="0.00"></label><label>Selling price (₹)<input type="number" name="sellingPrice" min="0" step="0.01" value="<%= product.selling_price??product.sellingPrice??'' %>" placeholder="0.00"></label><label>Low-stock threshold<input type="number" name="lowStockThreshold" min="0" step="1" value="<%= product.low_stock_threshold??product.lowStockThreshold??'' %>" placeholder="Use organization default"></label><label class="span-2">Description (optional)<textarea name="description" rows="3" maxlength="500" placeholder="A short description"><%= product.description||'' %></textarea></label></div><p class="field-help">Leave the threshold blank to use your organization’s default setting.</p><div class="form-actions"><a class="btn secondary" href="/products">Cancel</a><button class="btn primary"><%= product.id?'Save changes':'Create product' %></button></div></form></section></main></body></html>
