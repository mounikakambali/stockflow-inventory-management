<%- include('partials-head') %><%- include('partials-nav') %><main class="container narrow"><div class="page-heading"><div><p class="eyebrow">WORKSPACE</p><h1>Settings</h1><p class="muted">Configure how StockFlow flags low inventory.</p></div></div><section class="panel form-panel"><%- include('partials-flash') %><h2>Inventory preferences</h2><p class="muted">Organization: <strong><%= settings.name %></strong></p><% if(error){ %><div class="notice error"><%= error %></div><% } %><form method="post" action="/settings" class="stack"><label>Default low-stock threshold<input type="number" name="defaultThreshold" min="0" step="1" required value="<%= settings.default_low_stock_threshold %>"></label><p class="field-help">Products with no custom threshold use this value. A product is considered low stock when its quantity is less than or equal to its threshold.</p><div class="form-actions"><button class="btn primary">Save settings</button></div></form></section></main></body></html>
